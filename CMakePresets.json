{
  "version": 3,
  "configurePresets": [
    {
      "name": "linux-debug",
      "displayName": "Linux Debug Host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIAG_BUILD_TESTS": "ON",
        "DIAG_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release Host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DIAG_BUILD_TESTS": "ON",
        "DIAG_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux ASAN/UBSAN Host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIAG_BUILD_TESTS": "ON",
        "DIAG_BUILD_EXAMPLES": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "container-debug",
      "displayName": "Linux Debug Container",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/container-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIAG_BUILD_TESTS": "ON",
        "DIAG_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "container-asan",
      "displayName": "Linux ASAN/UBSAN Container",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/container-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DIAG_BUILD_TESTS": "ON",
        "DIAG_BUILD_EXAMPLES": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "container-release",
      "displayName": "Linux Release Container",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/container-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DIAG_BUILD_TESTS": "ON",
        "DIAG_BUILD_EXAMPLES": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    },
    {
      "name": "container-debug",
      "configurePreset": "container-debug"
    },
    {
      "name": "container-asan",
      "configurePreset": "container-asan"
    },
    {
      "name": "container-release",
      "configurePreset": "container-release"
    }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "container-debug",
      "configurePreset": "container-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    },
    {
      "name": "container-asan",
      "configurePreset": "container-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "container-release",
      "configurePreset": "container-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 30
      }
    }
  ]
}
